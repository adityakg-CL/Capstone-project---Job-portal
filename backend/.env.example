APP_NAME=CirrusLabs TalentHub API
ENVIRONMENT=development
API_V1_PREFIX=/api/v1
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=cirruslabs_talenthub
JWT_SECRET_KEY=replace-with-a-long-random-secret-before-running
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
FRONTEND_URL=http://localhost:5173
# Comma-separated list of allowed browser origins (must include the exact origin serving the app, e.g. http://localhost:8443)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8443
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
ALLOW_SELF_REGISTRATION=true
REGISTRATION_EMAIL_DOMAIN=cirruslabs.io
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
RESUME_STORAGE_DIR=storage/resumes
RESUME_MAX_SIZE_BYTES=5242880
